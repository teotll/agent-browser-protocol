import("//build/config/features.gni")
import("//build/config/ui.gni")

source_set("abp") {
  sources = [
    "abp_action_context.cc",
    "abp_action_context.h",
    "abp_config.cc",
    "abp_config.h",
    "abp_controller.cc",
    "abp_controller.h",
    "abp_input_dispatcher.cc",
    "abp_input_dispatcher.h",
    "abp_types.h",
    "abp_download_observer.cc",
    "abp_download_observer.h",
    "abp_event_collector.cc",
    "abp_event_collector.h",
    "abp_event_observer.cc",
    "abp_event_observer.h",
    "abp_history_controller.cc",
    "abp_history_controller.h",
    "abp_history_database.cc",
    "abp_history_database.h",
    "abp_http_server.cc",
    "abp_http_server.h",
    "abp_mcp_handler.cc",
    "abp_mcp_handler.h",
    "abp_switches.cc",
    "abp_switches.h",
    "abp_tool_builder.cc",
    "abp_tool_builder.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/download/public/common:public",
    "//components/input",
    "//components/version_info",
    "//content/public/browser",
    "//net",
    "//skia",
    "//sql",
    "//ui/base",
    "//ui/events:dom_keycode_converter",
    "//components/viz/common",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//ui/snapshot",
  ]

  if (use_aura) {
    deps += [ "//ui/aura" ]
  }

  if (is_mac) {
    frameworks = [ "IOKit.framework" ]
  }
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "abp_action_lifecycle_browsertest.cc",
  ]

  deps = [
    ":abp",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//net:test_support",
  ]

  if (is_mac) {
    frameworks = [ "IOKit.framework" ]
  }
}
